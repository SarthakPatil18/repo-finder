# GitHub Personal Access Token (Classic or Fine-grained)
# Used to increase rate limits (Search: 30 req/min, REST: 5,000 req/hour).
# Optional for light usage, but recommended for large scans.
GITHUB_TOKEN=

# Optional: Google Gemini API Key
# Used for optional LLM semantic feature extraction and synthesis.
# If omitted, high-precision deterministic AST/regex engine runs out of the box.
GEMINI_API_KEY=
